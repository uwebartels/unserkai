#!/usr/bin/env bash
# kai-models-pull - download GGUF model files listed in a list file and verify sha256.
# Usage: kai-models-pull [--dry-run] [--list FILE] [--dir DIR] [FILENAME...]
# List file format: one entry per line, 4 whitespace-separated fields:
#   sha256 size filename url
# Lines starting with # and blank lines are ignored.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: kai-models-pull [--dry-run] [--list FILE] [--dir DIR] [FILENAME...]

Options:
  --dry-run       Do not download or write; only report what would happen.
  --list FILE     List file to read.
  --dir DIR       Directory where model files are stored.
  -h, --help      Show this help and exit.

Defaults:
  DIR  = ${KAI_MODELS_DIR:-/opt/kai/models}
  FILE = ${KAI_MODELS_LIST:-/opt/kai/models.list}
         If the default list file does not exist, fall back to
         <directory of this script>/../models.list.
EOF
}

dry_run=0
list_file_explicit=0
list_file=${KAI_MODELS_LIST:-/opt/kai/models.list}
models_dir=${KAI_MODELS_DIR:-/opt/kai/models}
requested=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      dry_run=1
      ;;
    --list)
      if [[ $# -lt 2 ]]; then
        printf 'error: --list requires an argument\n' >&2
        exit 2
      fi
      list_file=$2
      list_file_explicit=1
      shift
      ;;
    --dir)
      if [[ $# -lt 2 ]]; then
        printf 'error: --dir requires an argument\n' >&2
        exit 2
      fi
      models_dir=$2
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      printf 'error: unknown option: %s\n' "$1" >&2
      exit 2
      ;;
    *)
      requested+=("$1")
      ;;
  esac
  shift
done

if [[ $# -gt 0 ]]; then
  requested+=("$@")
fi

declare -A requested_found=()
if [[ ${#requested[@]} -gt 0 ]]; then
  for name in "${requested[@]}"; do
    requested_found["$name"]=0
  done
fi

if [[ ! -f "$list_file" ]]; then
  if [[ $list_file_explicit -eq 0 ]]; then
    script_dir=$(dirname -- "${BASH_SOURCE[0]}")
    fallback_list="$script_dir/../models.list"
    if [[ -f "$fallback_list" ]]; then
      list_file=$fallback_list
    fi
  fi
fi

if [[ ! -f "$list_file" ]]; then
  printf 'error: list file not found: %s\n' "$list_file" >&2
  exit 1
fi

if [[ $dry_run -eq 0 ]]; then
  mkdir -p "$models_dir"
fi

lineno=0
while IFS= read -r line || [[ -n "$line" ]]; do
  lineno=$((lineno + 1))
  line=${line%$'\r'}

  if [[ -z "${line//[[:space:]]/}" ]]; then
    continue
  fi
  if [[ "$line" =~ ^[[:space:]]*# ]]; then
    continue
  fi

  read -r sha size name url rest <<< "$line"
  if [[ -z "${sha:-}" || -z "${size:-}" || -z "${name:-}" || -z "${url:-}" || -n "${rest:-}" ]]; then
    printf 'error: malformed list entry at line %d: %s\n' "$lineno" "$line" >&2
    exit 1
  fi
  if [[ ! "$sha" =~ ^[0-9a-fA-F]{64}$ ]]; then
    printf 'error: invalid sha256 at line %d: %s\n' "$lineno" "$sha" >&2
    exit 1
  fi
  if [[ ! "$size" =~ ^[0-9]+$ ]]; then
    printf 'error: invalid size at line %d: %s\n' "$lineno" "$size" >&2
    exit 1
  fi

  if [[ ${#requested_found[@]} -gt 0 ]]; then
    if [[ -z "${requested_found[$name]+x}" ]]; then
      continue
    fi
    requested_found["$name"]=1
  fi

  target="$models_dir/$name"
  if [[ -f "$target" ]]; then
    actual_sha=$(sha256sum "$target" | cut -d ' ' -f 1)
    if [[ "$actual_sha" == "$sha" ]]; then
      printf 'ok: %s\n' "$name"
      continue
    fi
  fi

  if [[ $dry_run -eq 1 ]]; then
    printf 'would pull: %s\n' "$name"
    continue
  fi

  part="$target.part"
  if ! curl -fL -C - --retry 3 --retry-delay 5 -o "$part" "$url"; then
    printf 'error: download failed for %s\n' "$name" >&2
    exit 1
  fi

  actual_size=$(wc -c < "$part")
  if [[ "${actual_size//[[:space:]]/}" != "$size" ]]; then
    rm -f "$part"
    printf 'error: size mismatch for %s: expected %s, got %s\n' \
      "$name" "$size" "${actual_size//[[:space:]]/}" >&2
    exit 1
  fi

  actual_sha=$(sha256sum "$part" | cut -d ' ' -f 1)
  if [[ "$actual_sha" != "$sha" ]]; then
    rm -f "$part"
    printf 'error: sha256 mismatch for %s\n' "$name" >&2
    exit 1
  fi

  mv "$part" "$target"
  printf 'pulled: %s\n' "$name"
done < "$list_file"

if [[ ${#requested_found[@]} -gt 0 ]]; then
  missing=()
  for name in "${!requested_found[@]}"; do
    if [[ "${requested_found[$name]}" -eq 0 ]]; then
      missing+=("$name")
    fi
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    printf 'error: filename not in list: %s\n' "${missing[@]}" >&2
    exit 2
  fi
fi
