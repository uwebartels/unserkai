# Kai — Umgebungsvariablen fuer den Compose-Stack
#
# Kopie als /opt/kai/.env auf der Maschine anlegen, Werte eintragen, Rechte 0600 root.
# Diese Datei (.env.example) wird committet, .env NIE (siehe .gitignore).
# Jede Variable ist dokumentiert; leer gelassene Pflichtwerte lassen "docker compose up" scheitern.

# --- Brave Search (MCP-Werkzeug fuer Open WebUI) -------------------------------
# API-Key aus https://api-dashboard.search.brave.com/ (Plan "Free" reicht fuer den Start).
BRAVE_API_KEY=

# --- Open WebUI ----------------------------------------------------------------
# Zufaelliger Schluessel, signiert Sitzungs-Tokens. Einmal erzeugen, dann nicht mehr aendern
# (sonst sind alle angemeldet Nutzer abgemeldet):  openssl rand -hex 32
WEBUI_SECRET_KEY=

# Anzeigename der Instanz in der Oberflaeche.
WEBUI_NAME=Kai


# Registrierung neuer Konten: true nur fuer die Einrichtung der vier Konten, danach false.
ENABLE_SIGNUP=true

# Wartezeit auf eine Modellantwort in Sekunden. Muss den ersten Modell-Ladevorgang
# ueber llama-swap abdecken (EBS: bis ~120 s), sonst "Error submitting message".
AIOHTTP_CLIENT_TIMEOUT=600

# --- LiteLLM -------------------------------------------------------------------
# Master-Key von LiteLLM (beginnt mit sk-):  echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=

# Salz, mit dem LiteLLM gespeicherte Anbieter-Keys verschluesselt. Einmal erzeugen und nie mehr
# aendern (sonst sind gespeicherte Keys unlesbar):  echo "sk-$(openssl rand -hex 24)"
LITELLM_SALT_KEY=

# Passwort der LiteLLM-Datenbank (nur im Docker-Netz erreichbar):  openssl rand -hex 24
LITELLM_DB_PASSWORD=

# Key, den llama-swap auf kai-gpu verlangt; derselbe Wert wie in /opt/kai/.env auf kai-gpu (LiteLLM,
# Pfoertner und kai-smoke senden ihn):  echo "sk-$(openssl rand -hex 24)"
LLAMA_SWAP_KEY=

# Login der LiteLLM-Admin-UI ohne Master-Key: solange das gepinnte LiteLLM (1.83.x) die Option
# disable_env_credential_login nicht kennt, ersetzen diese beiden Werte den Umgebungs-Login
# (sonst gilt admin + Master-Key). Werte nur in der Team-KeePass, nie benutzen; eigene Konten sind der Login.
#   echo "ui-$(openssl rand -hex 8)" ; echo "$(openssl rand -hex 32)"
UI_USERNAME=
UI_PASSWORD=

# Virtueller LiteLLM-Key fuer Open WebUI (nach dem ersten Start im Admin-UI anlegen).
OPENWEBUI_LITELLM_KEY=
