# Von Ansible erzeugt (Rolle kai_pfoertner); Konzept: kai/docs/05_vorschlag-auto-stop.md
[Unit]
Description=kai-pfoertner: startet GPU-Maschinen bei Bedarf und stoppt sie nach Leerlauf
After=docker.service network-online.target
Wants=network-online.target docker.service

[Service]
ExecStart={{ kai_pfoertner_bin }} --config {{ kai_pfoertner_config_dir }}/config.json serve
Restart=always
RestartSec=5
StateDirectory=kai-pfoertner
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
