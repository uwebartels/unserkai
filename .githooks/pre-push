#!/usr/bin/env bash
# Runs before every push: refuses pushes to main and scans the pushed commits with gitleaks.
# main changes only through a pull request; ALLOW_PUSH_MAIN=1 overrides on purpose.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
remote="$1"
zero="0000000000000000000000000000000000000000"
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "$local_ref" ]] && continue
  [[ "$local_sha" == "$zero" ]] && continue # branch deletion
  if [[ "$remote_ref" == "refs/heads/main" && "${ALLOW_PUSH_MAIN:-0}" != "1" ]]; then
    echo "pre-push: refusing to push $local_ref to main of $remote; open a pull request instead (ALLOW_PUSH_MAIN=1 overrides)" >&2
    fail=1
    continue
  fi
  if [[ "$remote_sha" == "$zero" ]]; then
    range="$local_sha --not --remotes=$remote"
  else
    range="$remote_sha..$local_sha"
  fi
  if gitleaks git --help >/dev/null 2>&1; then
    gitleaks git . --no-banner --redact --log-opts="$range" || fail=1
  else
    gitleaks detect --source . --no-banner --redact --log-opts="$range" || fail=1
  fi
done
exit "$fail"
